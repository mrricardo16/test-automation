{
  "name": "automated-testing",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:project-preparation": "node scripts/web/run-project-preparation.mjs",
    "test:project-preparation:persistent": "node scripts/web/run-project-preparation-persistent-session.mjs",
    "test:prep-02-locator-diagnostic": "node scripts/web/run-prep-02-locator-diagnostic.mjs",
    "test:local-visible-persistent-session": "node scripts/web/run-local-visible-persistent-session.mjs",
    "test:preparation-session:prep-02": "node scripts/web/run-preparation-session-prep-02.mjs",
    "test:preparation-session:prep-03-browser-chrome-readiness": "node scripts/web/run-preparation-session-prep-03-browser-chrome-readiness.mjs",
    "test:preparation-session:prep-04-to-06": "node scripts/web/run-preparation-session-prep-04-to-06.mjs",
    "test:preparation-session:prep-03-to-06": "node scripts/web/run-preparation-session-prep-03-to-06.mjs",
    "test:appium": "node --test tests/avalonia/e2e/appium/TC_AVA_E2E_ENV_001_AppiumEnvironment.spec.mjs tests/avalonia/e2e/appium/TC_AVA_E2E_001_RealLogImport.spec.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.platform.json",
    "typecheck:negative": "node scripts/platform/verify-negative-types.mjs",
    "lint": "eslint \"scripts/platform/**/*.ts\" \"tests/acceptance/**/*.ts\" \"tests/api/synthetic/**/*.ts\" \"tests/types/**/*.ts\" tests/web/platform-contract-validator.spec.ts tests/web/synthetic-product-runtime.spec.ts --config eslint.config.mjs",
    "test:web": "node scripts/platform/run-platform-tests.mjs web",
    "test:api": "node scripts/platform/run-platform-tests.mjs api",
    "test:skills": "node scripts/platform/run-skill-tests.mjs",
    "test:contracts": "node scripts/platform/run-platform-tests.mjs contracts",
    "test:synthetic": "node scripts/platform/run-platform-tests.mjs synthetic",
    "test:profiles": "node scripts/platform/run-platform-tests.mjs profiles",
    "test:aggregation": "node scripts/platform/run-platform-tests.mjs aggregation",
    "test:blackbox-standard-rebuild": "node --test projects/rsscomposer-blackbox/scripts/blackbox-standard-rebuild.test.mjs",
    "test:generic-blackbox-policy": "node --test scripts/platform/generic-blackbox-policy.test.mjs",
    "test:final-markdown-rendering": "node --test scripts/platform/final-markdown-rendering-validator.test.mjs",
    "test:testcase-id": "node --test scripts/platform/testcase-id-validator.test.mjs",
    "install:typora-report-theme": "node scripts/platform/install-typora-report-theme.mjs",
    "materialize:fine-grained-catalog": "node projects/rsscomposer-blackbox/scripts/render-final-test-report.mjs",
    "test:fine-grained-catalog": "node --test projects/rsscomposer-blackbox/scripts/materialize-fine-grained-catalog.test.mjs",
    "validate:fine-grained-catalog": "node projects/rsscomposer-blackbox/scripts/validate-fine-grained-catalog.mjs",
    "generate:blackbox-standard-rebuild": "node projects/rsscomposer-blackbox/scripts/blackbox-standard-rebuild.mjs",
    "validate:blackbox-standard-rebuild": "node projects/rsscomposer-blackbox/scripts/validate-blackbox-standard-rebuild.mjs",
    "governance": "node --test tests/platform/governance-check.spec.mjs && node scripts/platform/governance-check.mjs",
    "validate": "node scripts/platform/run-platform-validation.mjs",
    "test:platform": "node scripts/platform/run-platform-quality.mjs",
    "ci:safety": "node --test tests/ci/ci-safety-check.spec.mjs && node scripts/platform/ci-safety-check.mjs",
    "test:ci": "npm run ci:safety && npm run validate && npm run test:platform"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "appium": "3.6.0",
    "appium-windows-driver": "6.1.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "yaml": "^2.9.0"
  }
}
