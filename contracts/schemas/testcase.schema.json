{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automated-testing.local/contracts/testcase.schema.json",
  "title": "Canonical TestCase V2 with legacy compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["TestCaseId", "ModuleId", "FeatureId", "Title", "Priority", "TestType", "TestLayer", "ApplicabilityStatus", "ExpectedBasis", "AutomationType", "AutomationFramework"],
  "properties": {
    "TestCaseId": {
      "type": "string",
      "pattern": "^(TC-[A-Z0-9]+-[A-Z0-9-]+|INFRASTRUCTURE_SELF_TEST)$",
      "description": "Current project catalogs use TC-<FEATURE_CODE>-<OPERATION_CODE>-<SEQ>; the broad pattern retains compatibility for platform contracts, while testcase-id-validator.mjs enforces the current stable format and the separate TC-BB-REAL historical exception."
    },
    "ModuleId": { "type": "string", "minLength": 1 },
    "FeatureId": { "type": "string", "minLength": 1 },
    "ModuleName": { "type": "string", "minLength": 1 },
    "FeatureName": { "type": "string", "minLength": 1 },
    "Operation": { "enum": ["QUERY", "CREATE", "UPDATE", "DELETE", "VALIDATION", "STATE_TRANSITION", "PERMISSION", "RELATIONSHIP", "IMPORT", "EXPORT", "DOWNLOAD", "UPLOAD", "AUTHENTICATION", "SESSION", "COMPOSITE_LIFECYCLE", "VISUAL", "OTHER"] },
    "ScenarioGroup": { "enum": ["HAPPY_PATH", "CONDITION", "VALIDATION", "NEGATIVE", "BOUNDARY", "EMPTY_STATE", "DUPLICATE", "PERMISSION", "STATE", "RELATIONSHIP", "POST_CONDITION", "ERROR_HANDLING", "RECOVERY", "IDEMPOTENCY", "COMPOSITE_FLOW", "MANUAL_BOUNDARY"] },
    "PresentationOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ModuleOrder", "FeatureOrder", "OperationOrder", "ScenarioOrder", "CaseOrder"],
      "properties": {
        "ModuleOrder": { "type": "integer", "minimum": 1 },
        "FeatureOrder": { "type": "integer", "minimum": 1 },
        "OperationOrder": { "type": "integer", "minimum": 1 },
        "ScenarioOrder": { "type": "integer", "minimum": 1 },
        "CaseOrder": { "type": "integer", "minimum": 1 }
      }
    },
    "BusinessRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "TestDataDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DataFields", "DataCategory", "KeyValues", "Source", "Ownership", "Unique", "Disposable", "Sensitive"],
      "properties": {
        "DataFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "DataCategory": { "enum": ["VALID_DATA", "INVALID_DATA", "BOUNDARY_DATA", "EXISTING_DATA", "NON_EXISTING_DATA", "DUPLICATE_DATA", "EMPTY_DATA", "TEST_OWNED_DATA", "DISPOSABLE_DATA", "REFERENCE_DATA"] },
        "KeyValues": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "Source": { "type": "string", "minLength": 1 },
        "Ownership": { "type": "string", "minLength": 1 },
        "Unique": { "type": "boolean" },
        "Disposable": { "type": "boolean" },
        "Sensitive": { "type": "boolean" }
      }
    },
    "SafetyConstraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "DesignTechniques": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["EQUIVALENCE_PARTITIONING", "BOUNDARY_VALUE", "DECISION_TABLE", "STATE_MODEL", "CRUD_LIFECYCLE_MATRIX", "QUERY_TEST_MATRIX", "PERMISSION_MATRIX", "RELATIONSHIP_MATRIX", "ERROR_RECOVERY", "IDEMPOTENCY_ANALYSIS", "PAIRWISE", "REPRESENTATIVE_PARTITION", "MANUAL_BOUNDARY"] } },
    "BoundaryValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Applicable"],
      "properties": {
        "Applicable": { "type": "boolean" },
        "Values": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ExpectedKnown": { "type": "boolean" }
      }
    },
    "DesignMaturity": { "enum": ["DRAFT", "REVIEWABLE", "EXECUTABLE", "LIMITED"] },
    "EffectiveAutomationEligibility": { "enum": ["AUTO_ALLOWED", "MANUAL_REQUIRED", "NOT_EXECUTABLE"] },
    "DependsOnTestCaseId": { "type": "string", "minLength": 1 },
    "Title": { "type": "string", "minLength": 1 },
    "Priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "TestType": { "type": "string", "minLength": 1 },
    "TestLayer": { "type": "string", "minLength": 1 },
    "ApplicabilityStatus": { "enum": ["APPLICABLE", "NOT_APPLICABLE", "CONDITIONAL", "UNKNOWN"] },
    "ExpectedBasis": { "enum": ["REQUIREMENT", "DESIGN", "APPROVED_BASELINE", "HANDOFF_BASELINE", "CODE_BEHAVIOR", "UNKNOWN"] },
    "ExpectedResult": { "type": "string", "minLength": 1 },
    "ExpectedStatus": { "enum": ["EXPECTED_CONFIRMED", "EXPECTED_PENDING_AUTHORITY"] },
    "ExpectedSourceRef": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "ExpectedAuthority": { "type": "string", "minLength": 1 },
    "ExpectedAuthorityCompleteness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AuthoritySourcesAvailable", "AuthoritySourcesSearched", "RelevantSectionsFound", "BusinessRulesExtracted", "ExpectedCandidateFound", "ExpectedSourceRef", "SearchCompleteness"],
      "properties": {
        "AuthoritySourcesAvailable": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "AuthoritySourcesSearched": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "RelevantSectionsFound": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "BusinessRulesExtracted": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ExpectedCandidateFound": { "enum": ["Yes", "No"] },
        "ExpectedSourceRef": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "SearchCompleteness": { "enum": ["COMPLETE", "INCOMPLETE"] }
      }
    },
    "ExpectationGapId": { "type": "string", "pattern": "^(EG|GAP)-[A-Z0-9]+-[A-Z0-9-]+$" },
    "GapClassification": { "enum": ["EXPECTED_EXTRACTION_MISS", "TRUE_GAP"] },
    "ExpectedResultSemantics": { "enum": ["AUTHORITY_GAP_DESCRIPTION_NOT_BUSINESS_ORACLE"] },
    "BusinessRuleRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "TraceabilityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "AutomationType": { "enum": ["AUTO", "AUTO_PARTIAL", "MANUAL"] },
    "AutomationFramework": { "type": "string", "minLength": 1 },
    "CandidateState": { "enum": ["DESIGN_CANDIDATE", "ACTIVE", "RETIRED"] },
    "DesignState": { "enum": ["REVIEWED", "UNREVIEWED"] },
    "ActivationStatus": { "enum": ["NOT_ACTIVATED", "AUTO_ACTIVATED", "MANUAL_REQUIRED", "BLOCKED", "NOT_EXECUTABLE"] },
    "ActivationDecision": { "enum": ["AUTO_ACTIVATE", "MANUAL_REQUIRED", "BLOCKED", "NOT_EXECUTABLE"] },
    "ExecutionQueueDecision": { "enum": ["ENQUEUE", "MANUAL_QUEUE", "BLOCKED", "EMPTY"] },
    "ExpectationGapApplicable": { "type": "boolean" },
    "RiskReasonBefore": { "type": "string", "minLength": 1 },
    "RiskReasonAfter": { "type": "string", "minLength": 1 },
    "CurrentAutomationEligibility": { "enum": ["AUTO_ALLOWED", "MANUAL_REQUIRED", "NOT_EXECUTABLE"] },
    "CurrentRisk": { "enum": ["RISK_LOW", "RISK_MEDIUM", "RISK_HIGH", "RISK_CRITICAL"] },
    "CurrentReadiness": { "enum": ["READY", "BLOCKED", "MANUAL", "NOT_EXECUTABLE"] },
    "CurrentBlocker": { "type": "string", "minLength": 1 },
    "ReadinessChanged": { "type": "boolean" },
    "ActivationReason": { "type": "string", "minLength": 1 },
    "PreviousAutomationEligibility": { "enum": ["AUTO_ALLOWED", "MANUAL_REQUIRED", "NOT_EXECUTABLE"] },
    "PreviousRisk": { "enum": ["RISK_LOW", "RISK_MEDIUM", "RISK_HIGH", "RISK_CRITICAL"] },
    "PreviousActivationDecision": { "type": "string", "minLength": 1 },
    "PreviousReadiness": { "enum": ["READY", "BLOCKED", "MANUAL", "NOT_EXECUTABLE"] },
    "CaseKind": { "enum": ["ATOMIC", "COMPOSITE"] },
    "ScenarioSuiteId": { "type": "string", "pattern": "^SS-[A-Z0-9]+-[A-Z0-9-]+$" },
    "Objective": { "type": "string", "minLength": 1 },
    "PrimaryAssertion": { "type": "string", "minLength": 1 },
    "SupportingAssertions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "IntermediateAssertions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "LifecycleStatus": { "enum": ["DRAFT", "ACTIVE", "RETIRED"] },
    "ReviewGateStatus": { "enum": ["PASS", "LIMITED", "FAIL"] },
    "RiskLevel": { "enum": ["RISK_LOW", "RISK_MEDIUM", "RISK_HIGH", "RISK_CRITICAL"] },
    "SideEffects": { "enum": ["NONE", "TEST_DATA_CREATE", "TEST_DATA_UPDATE", "TEST_DATA_DELETE", "AUTH_CHANGE", "SESSION_CHANGE", "GLOBAL_CONFIG_CHANGE", "EXTERNAL_EFFECT"] },
    "SideEffectScope": { "enum": ["TEST_OWNED", "PROJECT_SANDBOX", "SHARED_ENVIRONMENT", "UNKNOWN"] },
    "Reversibility": { "enum": ["REVERSIBLE", "CLEANUP_REVERSIBLE", "IRREVERSIBLE", "UNKNOWN"] },
    "DataOwnership": { "enum": ["TEST_OWNED", "PROJECT_SANDBOX", "SHARED_ENVIRONMENT", "UNKNOWN"] },
    "InteractionMode": { "enum": ["UNATTENDED", "INTERACTIVE"] },
    "AutomationEligibility": { "enum": ["AUTO_ALLOWED", "MANUAL_REQUIRED", "NOT_EXECUTABLE"] },
    "InitialState": { "type": "string", "minLength": 1 },
    "Preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "TestData": {},
    "Steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "ExpectedPerStep": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expectedStep" } },
    "StateTransitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateTransition" } },
    "PostConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "CrossStepInvariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "Cleanup": { "type": "string", "minLength": 1 },
    "CleanupVerification": { "type": "string", "minLength": 1 },
    "ExpectationGapRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EG-[A-Z0-9]+-[A-Z0-9-]+$" } },
    "SourceActiveTestCaseId": { "type": "string", "minLength": 1 },
    "ExpectedSource": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "CoverageTags": { "type": "array", "uniqueItems": true, "items": { "enum": ["HAPPY_PATH", "BUSINESS_RULE", "VALIDATION", "BOUNDARY", "NEGATIVE", "PERMISSION", "AUTHENTICATION", "STATE_TRANSITION", "POST_CONDITION", "DATA_CONSISTENCY", "REFERENTIAL_INTEGRITY", "IDEMPOTENCY", "DUPLICATE", "RECOVERY", "SESSION", "COMPOSITE_FLOW", "LIFECYCLE", "CONCURRENCY", "CLEANUP", "MANUAL_BOUNDARY", "CRUD_LIFECYCLE", "ERROR_MODEL"] } },
    "Dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "DestructiveRisk": { "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"] },
    "EvidenceRequirement": { "type": ["string", "array"] },
    "Environment": { "type": "string" },
    "Status": { "type": "string" },
    "Limitations": { "type": "string" },
    "Covers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "expectedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Step", "Action", "Expected", "StateAfter"],
      "properties": {
        "Step": { "type": "integer", "minimum": 1 },
        "Action": { "type": "string", "minLength": 1 },
        "Expected": { "type": "string", "minLength": 1 },
        "StateAfter": { "type": "string", "minLength": 1 }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["From", "Action", "To"],
      "properties": {
        "From": { "type": "string", "minLength": 1 },
        "Action": { "type": "string", "minLength": 1 },
        "To": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["CaseKind"] },
      "then": { "properties": { "Priority": { "enum": ["P0", "P1", "P2"] } } }
    },
    {
      "if": { "required": ["CaseKind"] },
      "then": { "required": ["ScenarioSuiteId", "Objective", "PrimaryAssertion", "LifecycleStatus", "ReviewGateStatus", "RiskLevel", "SideEffects", "SideEffectScope", "Reversibility", "DataOwnership", "InteractionMode", "AutomationEligibility", "CoverageTags", "ModuleName", "FeatureName", "Operation", "ScenarioGroup", "PresentationOrder", "BusinessRules", "TestDataDesign", "SafetyConstraints", "DesignTechniques", "DesignMaturity", "PostConditions"] },
      "else": { "required": ["ExpectedResult"] }
    },
    {
      "if": { "required": ["CaseKind"], "properties": { "CaseKind": { "const": "COMPOSITE" } } },
      "then": { "required": ["InitialState", "Preconditions", "TestData", "Steps", "ExpectedPerStep", "IntermediateAssertions", "StateTransitions", "PostConditions", "CrossStepInvariants", "Cleanup", "CleanupVerification"] }
    },
    {
      "if": { "required": ["ExpectedBasis"], "properties": { "ExpectedBasis": { "const": "UNKNOWN" } } },
      "then": {
        "required": ["ExpectationGapRefs"],
        "properties": { "ReviewGateStatus": { "enum": ["LIMITED", "FAIL"] }, "AutomationEligibility": { "const": "NOT_EXECUTABLE" } },
        "oneOf": [
          { "properties": { "ExpectedResult": false }, "not": { "required": ["ExpectedStatus"] } },
          {
            "required": ["ExpectedStatus", "ExpectedResult", "ExpectedSourceRef", "ExpectedAuthority", "ExpectationGapId", "GapClassification", "ExpectedResultSemantics"],
            "properties": {
              "ExpectedStatus": { "const": "EXPECTED_PENDING_AUTHORITY" },
              "ExpectedAuthority": { "const": "PENDING_AUTHORITY" },
              "ExpectedResultSemantics": { "const": "AUTHORITY_GAP_DESCRIPTION_NOT_BUSINESS_ORACLE" }
            }
          }
        ]
      }
    },
    {
      "if": { "required": ["CaseKind"], "properties": { "CaseKind": { "const": "COMPOSITE" } } },
      "then": { "not": { "properties": { "AutomationType": { "const": "AUTO_PARTIAL" } } } }
    },
    {
      "if": { "required": ["AutomationEligibility"], "properties": { "AutomationEligibility": { "const": "AUTO_ALLOWED" } } },
      "then": { "properties": { "AutomationType": { "const": "AUTO" }, "LifecycleStatus": { "const": "ACTIVE" }, "ReviewGateStatus": { "const": "PASS" }, "RiskLevel": { "enum": ["RISK_LOW", "RISK_MEDIUM"] }, "SideEffectScope": { "enum": ["TEST_OWNED", "PROJECT_SANDBOX"] }, "Reversibility": { "enum": ["REVERSIBLE", "CLEANUP_REVERSIBLE"] }, "InteractionMode": { "const": "UNATTENDED" } } }
    }
  ]
}
