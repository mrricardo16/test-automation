{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automated-testing.local/contracts/scenario-suite.schema.json",
  "title": "ScenarioSuite",
  "type": "object",
  "additionalProperties": false,
  "required": ["ScenarioSuiteId", "ModuleId", "FeatureId", "Title", "Objective", "BusinessFlow", "IncludedTestCases", "LifecyclePath", "CoverageTags", "Risks", "CleanupStrategy"],
  "properties": {
    "ScenarioSuiteId": { "type": "string", "pattern": "^SS-[A-Z0-9]+-[A-Z0-9-]+$" },
    "ModuleId": { "type": "string", "minLength": 1 },
    "FeatureId": { "type": "string", "minLength": 1 },
    "Title": { "type": "string", "minLength": 1 },
    "Objective": { "type": "string", "minLength": 1 },
    "BusinessFlow": { "type": "string", "minLength": 1 },
    "IncludedTestCases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TC-[A-Z0-9]+-[A-Z0-9-]+$" } },
    "LifecyclePath": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "CoverageTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "Risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "CleanupStrategy": { "type": "string", "minLength": 1 },
    "ExpectationGapIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EG-[A-Z0-9]+-[A-Z0-9-]+$" } },
    "LifecycleStatus": { "enum": ["DRAFT", "ACTIVE", "RETIRED"] }
  }
}
